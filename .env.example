# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey  (no card needed; free-tier limits can change)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_complete_api_key
GEMINI_MODEL=gemini-2.5-flash

# To swap models, e.g. for the interview:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-haiku-5-5

# LLM_PROVIDER=none   -> regex-only fallback (no API calls)
